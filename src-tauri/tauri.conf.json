{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "coverDrop",
  "version": "1.0.0",
  "identifier": "com.coverdrop.pdf-cover-extractor",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "coverDrop", "width": 900, "height": 820, "minWidth": 580, "minHeight": 680, "resizable": true }], "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src 'self' http://localhost:1420 ws://localhost:1420", "assetProtocol": { "enable": true, "scope": ["$APPCACHE/previews/**"] } } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.icns", "icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"], "resources": ["binaries/**/*"] }
}
